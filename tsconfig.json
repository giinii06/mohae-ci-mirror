{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "bun"
    ],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "apps/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts"
  ]
}
